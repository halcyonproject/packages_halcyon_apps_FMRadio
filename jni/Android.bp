cc_library_shared {
    name: "libmtkfmjni",

    srcs: [
        "LibfmJni.cpp",
        "mtk/fmr_core.cpp",
        "mtk/fmr_err.cpp",
        "mtk/common.cpp",
        "mtk/custom.cpp",
    ],

    cflags: [
        "-DFM_SOC_MTK",
        "-Wno-unused-parameter",
    ],

    local_include_dirs: [
        "mtk",
    ],

    header_libs: [
        "jni_headers",
    ],

    shared_libs: [
        "libcutils",
        "libdl",
        "libmedia",
        "liblog",
    ],
}

cc_library_shared {
    name: "libqcomfmjni",

    srcs: [
        "LibfmJni.cpp",
        "qcom/FmIoctlsInterface.cpp",
        "qcom/ConfigFmThs.cpp",
        "qcom/FmPerformanceParams.cpp",
        "qcom/ConfFileParser.cpp",
        "qcom/FmRadioController.cpp",
    ],

    cflags: [
        "-DFM_SOC_QCOM",
        "-Wno-unused-parameter",
    ],

    local_include_dirs: [
        "qcom",
    ],

    header_libs: [
        "jni_headers",
    ],

    shared_libs: [
        "libcutils",
        "libdl",
        "liblog",
        "libmedia",
        "libnativehelper",
    ],
}
